# syntax=docker/dockerfile:1
# IndexTTS-2.5 -- 22.05 kHz, emotion control. Conditions on the reference clip
# alone (first 15 s, hard cut); no reference transcript.
#
# Backend-agnostic: build args select CUDA or ROCm. See the compose overlays.
#   CUDA: TORCH_INDEX=.../cu126   TORCH=2.8.0  TORCH_BUILD_TAG=cu126
#   ROCm: TORCH_INDEX=.../rocm6.4 TORCH=2.8.0  TORCH_BUILD_TAG=rocm6.4
#
# Two deviations from upstream's install:
#
#  1. PYTHON 3.11, not 3.12 -- index-tts declares requires-python ">=3.10,<3.12".
#     This one is backend-independent.
#  2. NO `--all-extras`. Upstream says `uv sync --all-extras`, but on the Pascal
#     P40 every extra is unusable: flash-attn needs sm_80+, torch_compile needs
#     Triton (sm_70+), and deepspeed would need a CUDA toolkit this image does
#     not carry. On ROCm these extras ARE plausible (flash-attn and deepspeed
#     both have ROCm builds) -- see INDEXTTS_EXTRAS below.
#
# It also ships no PyPI package, so it is installed from a clone. There is no
# reason for a nested venv in a container, hence `uv pip --system`.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/models/hf \
    PIP_CONSTRAINT=/opt/tts/constraints.txt \
    UV_CONSTRAINT=/opt/tts/constraints.txt \
    CUDA_MODULE_LOADING=LAZY

# libnuma1 / libelf1 are ROCm runtime requirements; they are a few hundred KB
# and harmless on CUDA, so the package list stays backend-agnostic.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates ffmpeg libsndfile1 libnuma1 libelf1 \
    && rm -rf /var/lib/apt/lists/*

# ── Backend selection ─────────────────────────────────────────────────────────
# NOTHING here is NVIDIA-specific except the default values. Point TORCH_INDEX
# at a ROCm index and the same Dockerfile produces an AMD image:
#
#   CUDA (Pascal P40): https://download.pytorch.org/whl/cu126      tag cu126
#   ROCm (RDNA3):      https://download.pytorch.org/whl/rocm6.4    tag rocm6.4
#
# The compose overlays (docker-compose.cuda.yml / .rocm.yml) set these, so you
# normally switch backends there rather than here.
#
# Two constraints drive the version numbers, and they are not interchangeable
# between engines: Chatterbox pins torch==2.6.0 exactly, IndexTTS pins 2.8.*.
# The cu126 index is the last one carrying Pascal (sm_61) kernels at all.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
ARG TORCH=2.8.0
ARG TORCHAUDIO=2.8.0
ARG TORCHVISION=0.23.0
ARG TORCH_BUILD_TAG=cu126

# The generated constraints file holds every later install (pip and uv) to
# exactly these versions, so an engine that drags in a different torch fails
# loudly at build time instead of silently swapping in a wheel built for the
# wrong accelerator.
RUN mkdir -p /opt/tts \
 && printf 'torch==%s\ntorchaudio==%s\ntorchvision==%s\n' "$TORCH" "$TORCHAUDIO" "$TORCHVISION" \
      > /opt/tts/constraints.txt \
 && pip install --index-url "$TORCH_INDEX" \
        "torch==$TORCH" "torchaudio==$TORCHAUDIO" "torchvision==$TORCHVISION"

RUN pip install uv

ARG INDEXTTS_REF=main
RUN git clone --depth 1 --branch "${INDEXTTS_REF}" \
        https://github.com/index-tts/index-tts.git /opt/index-tts

# Empty = core dependencies only (the Pascal-safe default). Set to
# "--all-extras" on a ROCm or Ampere+ build to pull flash-attn and deepspeed.
ARG INDEXTTS_EXTRAS=""

WORKDIR /opt/index-tts
# Core dependencies, then the package itself without re-resolving.
RUN uv pip install --system ${INDEXTTS_EXTRAS} -r pyproject.toml \
 && uv pip install --system --no-deps -e .

COPY tts-engine-common /opt/tts/tts-engine-common
RUN pip install /opt/tts/tts-engine-common fastapi uvicorn loguru soundfile

# Final guard: nothing installed above may have swapped torch for a build
# targeting the wrong accelerator. A version constraint cannot catch this --
# `torch==2.8.0` matches 2.8.0+cu126, 2.8.0+cu128 and 2.8.0+rocm6.4 alike, and
# only one of them runs on any given GPU. (An arch-list check is not possible
# here: the builder has no GPU, so torch.cuda.get_arch_list() returns [].)
RUN python -c "import sys,torch;v=torch.__version__;t='${TORCH_BUILD_TAG}';print('torch:',v,'| required backend tag:',t);sys.exit(0 if t in v else 'FATAL: torch '+v+' is not a '+t+' build; it cannot run on the target GPU.')"

# Code last: edits here don't invalidate the expensive layers above.
COPY impl /opt/tts/impl
COPY tools /opt/tts/tools
WORKDIR /opt/tts

# Point the checkpoint dir at the shared models volume -- upstream's default is
# a relative `checkpoints/`, which would land inside the container layer and be
# re-downloaded on every recreate.
ENV INDEXTTS_HOST=0.0.0.0 \
    INDEXTTS_PORT=7500 \
    INDEXTTS_DEVICE=cuda \
    INDEXTTS_MODEL_DIR=/models/indextts

EXPOSE 7500
HEALTHCHECK --interval=30s --timeout=5s --start-period=20m --retries=3 \
    CMD curl -fsS http://127.0.0.1:${INDEXTTS_PORT}/health || exit 1

CMD ["python", "impl/server_indexTTS.py"]
