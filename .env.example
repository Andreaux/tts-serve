# Copy to .env and adjust. Compose reads .env automatically.

# ── Backend switch ────────────────────────────────────────────────────────────
# Pick exactly ONE. This is what makes `docker compose ...` work without having
# to pass -f flags every time.
#
# NOTE the separator is ":" on Linux/macOS and ";" on Windows. Override with
# COMPOSE_PATH_SEPARATOR if needed.
COMPOSE_FILE=docker-compose.yml:docker-compose.cuda.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.rocm-wsl.yml

# ── Host ports ────────────────────────────────────────────────────────────────
# Each engine listens on 7500 inside its container; these are the host-side
# ports, chosen so all engines can run at once without colliding.
CHATTERBOX_PORT=7500
QWEN3TTS_PORT=7501
VOXCPM_PORT=7502
INDEXTTS_PORT=7503
OMNIVOICE_PORT=7504
LUXTTS_PORT=7505

# ── Accelerator tuning ────────────────────────────────────────────────────────
# torch.compile. Defaults: 1 (off) on CUDA because Pascal has no Triton;
# 0 (on) on ROCm where Triton works. Set explicitly to override either.
#TORCHDYNAMO_DISABLE=1

# ROCm only, and only for cards outside the officially supported gfx list.
# An RX 7800 XT (gfx1101) is supported, so this should stay empty.
#HSA_OVERRIDE_GFX_VERSION=11.0.0

# ── IndexTTS extras ───────────────────────────────────────────────────────────
# Halves weight memory. Worth setting if VRAM is tight.
INDEXTTS_USE_BF16=
# Enables the experimental `emotion_text` request field (otherwise a 400).
INDEXTTS_USE_QWEN_EMO=
